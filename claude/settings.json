{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "skillOverrides": {
    "agents-sdk": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "cloudflare-one": "off",
    "cloudflare-one-migrations": "off",
    "durable-objects": "off",
    "sandbox-sdk": "off",
    "turnstile-spin": "off",
    "workers-best-practices": "off",
    "wrangler": "off",
    "design-an-interface": "off",
    "git-guardrails-claude-code": "off",
    "migrate-to-shoehorn": "off",
    "obsidian-vault": "off",
    "pr-reviewer": "off",
    "prototype": "off",
    "qa": "off",
    "request-refactor-plan": "off",
    "research": "off",
    "scaffold-exercises": "off",
    "setup-pre-commit": "off",
    "web-perf": "off",
    "wizard": "off",
    "batch-grill-me": "off",
    "chief-of-staff": "off",
    "claude-handoff": "off",
    "edit-article": "off",
    "implement-spec": "off",
    "loop-me": "off",
    "setup-ts-deep-modules": "off",
    "teach": "off",
    "to-questionnaire": "off",
    "ubiquitous-language": "off",
    "wait-what": "off",
    "wayfinder": "off",
    "writing-beats": "off",
    "writing-fragments": "off",
    "writing-shape": "off",
    "ast-grep-outline": "off",
    "caveman": "off",
    "vercel-react-best-practices": "off",
    "wiki-docs": "off",
    "write-a-skill": "off",
    "zoom-out": "off",
    "setup-matt-pocock-skills": "off",
    "figma:figma-code-connect": "off",
    "figma:figma-code-workflows": "off",
    "figma:figma-create-new-file": "off",
    "figma:figma-generate-design": "off",
    "figma:figma-generate-diagram": "off",
    "figma:figma-generate-library": "off",
    "figma:figma-generative-plugins": "off",
    "figma:figma-implement-motion": "off",
    "figma:figma-shaders": "off",
    "figma:figma-spec": "off",
    "figma:figma-swiftui": "off",
    "figma:figma-use": "off",
    "figma:figma-use-figjam": "off",
    "figma:figma-use-motion": "off",
    "figma:figma-use-slides": "off",
    "atlassian:capture-tasks-from-meeting-notes": "off",
    "atlassian:generate-status-report": "off",
    "atlassian:jira-sprint-dashboard": "off",
    "atlassian:search-company-knowledge": "off",
    "atlassian:spec-to-backlog": "off",
    "atlassian:triage-issue": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:xlsx": "off"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "atlassian-mcp@anthropic-plugin-directory": true
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "theme": "dark",
  "preferredNotifChannel": "auto",
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Writes to .env.local, .env.production.example, or other .env* files in this repo"
    ]
  }
}
